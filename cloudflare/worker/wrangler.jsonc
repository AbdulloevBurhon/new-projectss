{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "obshaya-programma-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsekh4-licenses",
      "database_id": "e9e2e9aa-2059-47fd-991f-c5209830c45b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATES_BUCKET",
      "bucket_name": "tsekh4-updates"
    }
  ]
}
