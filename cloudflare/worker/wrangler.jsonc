{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsekh4-license-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsekh4-licenses",
      "database_id": "e9e2e9aa-2059-47fd-991f-c5209830c45b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "tsekh4-updates"
    }
  ]
}
